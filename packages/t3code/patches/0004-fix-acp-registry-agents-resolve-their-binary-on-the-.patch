Date: Fri, 30 Oct 2026 07:59:53 -0300
Subject: [PATCH 04/11] fix(acp): registry agents resolve their binary on the
 direnv PATH

The registry resolved the agent binary before the direnv environment was applied, so tools the
project provides through its .envrc were not found. Apply it first, and keep the process
environment's own variables on top.
---
 .../src/server/adapter.test.ts                | 38 +++++++++++
 .../src/server/adapter.ts                     | 64 ++++++++++++-------
 2 files changed, 78 insertions(+), 24 deletions(-)
 create mode 100644 packages/provider-acp-registry/src/server/adapter.test.ts

diff --git a/packages/provider-acp-registry/src/server/adapter.test.ts b/packages/provider-acp-registry/src/server/adapter.test.ts
new file mode 100644
index 0000000000..14524e244f
--- /dev/null
+++ b/packages/provider-acp-registry/src/server/adapter.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import { AcpRegistrySettings } from "../settings.ts";
+import { resolveAcpRegistrySpawn } from "./adapter.ts";
+import type * as AcpRegistrySupport from "./AcpRegistrySupport.ts";
+
+// Like the real resolver, which puts its managed bin directory ahead of the given PATH.
+const catalog = {
+  resolve: (_settings: unknown, _cwd: string, environment?: NodeJS.ProcessEnv) =>
+    Effect.succeed({
+      spawn: {
+        command: "agent",
+        args: [],
+        env: { PATH: `/managed/bin:${environment?.PATH ?? ""}` },
+      },
+    }),
+} as unknown as AcpRegistrySupport.AcpRegistryCatalog["Service"];
+const settings = Schema.decodeSync(AcpRegistrySettings)({});
+
+describe("resolveAcpRegistrySpawn", () => {
+  it.effect("launches with direnv's PATH behind the managed bin and without unset variables", () =>
+    Effect.gen(function* () {
+      const spawn = yield* resolveAcpRegistrySpawn({
+        catalog,
+        settings,
+        cwd: "/project",
+        environment: { ...process.env },
+        direnvEnvironment: { PATH: "/nix/store/tools/bin:/usr/bin", HOME: null },
+        processEnvironment: undefined,
+      });
+      expect(spawn.env?.PATH).toBe("/managed/bin:/nix/store/tools/bin:/usr/bin");
+      expect(spawn.env).not.toHaveProperty("HOME");
+      expect(spawn.extendEnv).toBe(false);
+    }),
+  );
+});
