diff --git a/apps/web/src/components/chat/ThreadDirenvControl.tsx b/apps/web/src/components/chat/ThreadDirenvControl.tsx
new file mode 100644
index 0000000000..997d04907d
--- /dev/null
+++ b/apps/web/src/components/chat/ThreadDirenvControl.tsx
@@ -0,0 +1,68 @@
+import type { EnvironmentId, ProjectId, ThreadId } from "@t3tools/contracts";
+import { projectEnvironmentIndicator } from "@t3tools/client-runtime/state/projectEnvironment";
+import { useNavigate } from "@tanstack/react-router";
+import { useGT } from "gt-react";
+import { TerminalSquareIcon } from "lucide-react";
+
+import { cn } from "~/lib/utils";
+import { appAtomRegistry } from "../../rpc/atomRegistry";
+import { projectEnvironment } from "../../state/projectEnvironment";
+import { useEnvironmentQuery } from "../../state/query";
+import { ThreadDetailsControl } from "./ThreadDetailsControl";
+import {
+  THREAD_DETAILS_PANEL_ICON_CLASS,
+  THREAD_DETAILS_PANEL_LABEL_CLASS,
+} from "./threadDetailsPanelStyles";
+
+export function useThreadDirenvStatus(
+  environmentId: EnvironmentId,
+  projectId: ProjectId,
+  threadId: ThreadId | null,
+) {
+  const target = { environmentId, projectId, threadId };
+  const query = useEnvironmentQuery(projectEnvironment.statusAtom(target));
+  return { target, query, indicator: projectEnvironmentIndicator(query.data) };
+}
+
+/** Whether the thread's direnv environment loads; render only when `indicator` is set. */
+export function ThreadDirenvControl(props: {
+  readonly status: ReturnType<typeof useThreadDirenvStatus>;
+}) {
+  const gt = useGT();
+  const navigate = useNavigate();
+  const { target, query, indicator } = props.status;
+  if (indicator === null) return null;
+  return (
+    <ThreadDetailsControl
+      type="button"
+      variant="ghost"
+      size="sm"
+      part="row"
+      onClick={() => {
+        if (indicator === "approval") {
+          projectEnvironment.reviewAgain(appAtomRegistry, target);
+          query.refresh();
+          return;
+        }
+        void navigate({ to: "/settings/worktrees" });
+      }}
+    >
+      <TerminalSquareIcon className={THREAD_DETAILS_PANEL_ICON_CLASS} aria-hidden />
+      <span className={cn("flex-1 text-left", THREAD_DETAILS_PANEL_LABEL_CLASS)}>direnv</span>
+      <span
+        className={cn(
+          "text-xs",
+          indicator === "on" && "text-success",
+          indicator === "approval" && "text-warning",
+          indicator === "off" && "text-muted-foreground",
+        )}
+      >
+        {indicator === "on"
+          ? gt("On", { $context: "direnv environment status" })
+          : indicator === "approval"
+            ? gt("Needs approval")
+            : gt("Off", { $context: "direnv environment status" })}
+      </span>
+    </ThreadDetailsControl>
+  );
+}
diff --git a/apps/web/src/components/chat/useProjectEnvironmentBanner.tsx b/apps/web/src/components/chat/useProjectEnvironmentBanner.tsx
new file mode 100644
index 0000000000..3cddc3d2c3
--- /dev/null
+++ b/apps/web/src/components/chat/useProjectEnvironmentBanner.tsx
@@ -0,0 +1,135 @@
+import { useAtomValue } from "@effect/atom-react";
+import type { ScopedProjectRef, ThreadId } from "@t3tools/contracts";
+import {
+  projectEnvironmentReview,
+  type ProjectEnvironmentTarget,
+} from "@t3tools/client-runtime/state/projectEnvironment";
+import { T, useGT } from "gt-react";
+import { TerminalSquareIcon } from "lucide-react";
+import { useState } from "react";
+
+import { cn } from "~/lib/utils";
+import { appAtomRegistry } from "../../rpc/atomRegistry";
+import { projectEnvironment } from "../../state/projectEnvironment";
+import { useEnvironmentQuery } from "../../state/query";
+import { serverEnvironment } from "../../state/server";
+import { useAtomCommand } from "../../state/use-atom-command";
+import { Button } from "../ui/button";
+import { toastManager } from "../ui/toast";
+import type { ComposerBannerStackItem } from "./ComposerBannerStack";
+
+/**
+ * Asks once per `.envrc` content before T3 Code loads a project's direnv
+ * environment, and again with a diff when it changes.
+ */
+export function useProjectEnvironmentBanner(
+  projectRef: ScopedProjectRef | null,
+  threadId: ThreadId | null,
+): ComposerBannerStackItem | null {
+  const gt = useGT();
+  const target: ProjectEnvironmentTarget | null =
+    projectRef === null ? null : { ...projectRef, threadId };
+  const query = useEnvironmentQuery(target === null ? null : projectEnvironment.statusAtom(target));
+  const approve = useAtomCommand(projectEnvironment.approve);
+  const updateSettings = useAtomCommand(serverEnvironment.updateSettings);
+  const [pending, setPending] = useState(false);
+  const dismissed = useAtomValue(projectEnvironment.dismissedAtom).dismissed;
+  const canApprove = useAtomValue(
+    projectEnvironment.approve.permissionAtom(projectRef?.environmentId ?? null),
+  );
+  const canTurnOff = useAtomValue(
+    serverEnvironment.updateSettings.permissionAtom(projectRef?.environmentId ?? null),
+  );
+  const review = projectEnvironmentReview(query.data);
+  if (target === null || review === null) return null;
+  if (projectEnvironment.isDismissed(dismissed, target, review.sha256)) return null;
+
+  const onApprove = async () => {
+    setPending(true);
+    const result = await approve({
+      environmentId: target.environmentId,
+      input: {
+        projectId: target.projectId,
+        ...(threadId === null ? {} : { threadId }),
+        sha256: review.sha256,
+      },
+    });
+    setPending(false);
+    if (result._tag === "Success" && !result.value.approved) {
+      toastManager.add({
+        type: "error",
+        title: gt("Could not approve the .envrc"),
+        description: result.value.error,
+      });
+    }
+    query.refresh();
+  };
+  const onTurnOff = async () => {
+    const overrides = appAtomRegistry.get(serverEnvironment.configValueAtom(target.environmentId))
+      ?.settings.projectSettingsOverrides[target.projectId];
+    await updateSettings({
+      environmentId: target.environmentId,
+      input: {
+        patch: {
+          projectSettingsOverrides: {
+            [target.projectId]: { ...overrides, enableDirenvEnvironment: false },
+          },
+        },
+      },
+    });
+    query.refresh();
+  };
+
+  const { changed } = review;
+  return {
+    id: `project-environment:${target.projectId}`,
+    group: "environment",
+    variant: changed ? "warning" : "info",
+    icon: <TerminalSquareIcon />,
+    title: changed
+      ? gt("The project's .envrc changed since you approved it")
+      : gt("This project has a direnv environment"),
+    description: review.tooLarge
+      ? gt(
+          "This .envrc is too large to review here. Run direnv allow in the project to approve it.",
+        )
+      : changed
+        ? gt("Agents keep the environment they started with until you approve the change.")
+        : gt(
+            "Load its .envrc for agents and setup scripts in this project and the worktrees T3 Code creates. It runs code on this machine.",
+          ),
+    children: review.tooLarge ? undefined : (
+      <pre className="mt-2 max-h-48 overflow-auto rounded-md bg-muted/50 px-3 py-2 font-mono text-xs leading-relaxed">
+        {review.lines.map((line, index) => (
+          <div
+            // oxlint-disable-next-line react/no-array-index-key -- lines repeat and never reorder
+            key={index}
+            className={cn(
+              line.kind === "added" && "text-success",
+              line.kind === "removed" && "text-destructive",
+            )}
+          >
+            {changed ? (line.kind === "added" ? "+ " : line.kind === "removed" ? "- " : "  ") : ""}
+            {line.text}
+          </div>
+        ))}
+      </pre>
+    ),
+    actions: canApprove ? (
+      <>
+        {canTurnOff ? (
+          <Button size="xs" variant="ghost" disabled={pending} onClick={() => void onTurnOff()}>
+            <T>Turn off for project</T>
+          </Button>
+        ) : null}
+        {review.tooLarge ? null : (
+          <Button size="xs" variant="default" disabled={pending} onClick={() => void onApprove()}>
+            {changed ? gt("Approve change") : gt("Approve")}
+          </Button>
+        )}
+      </>
+    ) : undefined,
+    dismissLabel: gt("Not now"),
+    onDismiss: () => projectEnvironment.dismiss(appAtomRegistry, target, review.sha256),
+  };
+}
diff --git a/apps/web/src/components/settings/ProjectEnvironmentSettings.tsx b/apps/web/src/components/settings/ProjectEnvironmentSettings.tsx
new file mode 100644
index 0000000000..fed3afe375
