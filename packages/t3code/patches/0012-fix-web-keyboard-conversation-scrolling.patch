-/* A workspace area with no control of its own takes F6 focus itself; keep that visible. */
-[data-workspace-area]:focus-visible {
+/* A workspace area with no control of its own takes F6 focus itself; keep that visible.
+   The conversation's timeline takes it instead, and its top fade mask would hide its own ring. */
+[data-workspace-area]:focus-visible,
+[data-workspace-area="conversation"]:has(.messages-timeline-scroll:focus-visible) {
   outline: 2px solid var(--ring);
   outline-offset: -2px;
 }
+
+.messages-timeline-scroll:focus-visible {
+  outline: none;
+}
