From c9c4615eb3ef38cfca1fd4bc4d7a4446761dd5cb Mon Sep 17 00:00:00 2001
From: Mel Boonchan <72452443+muunkk@users.noreply.github.com>
Date: Sun, 15 Nov 2026 11:35:31 +0800
Subject: [PATCH 16/16] fix(web): Shift+F6 moves from a side chat back to the
 main chat (#31931)

Co-authored-by: Julius Marminge <julius0216@outlook.com>
(cherry picked from commit def3722faa3695034c03058e6ca73c31db353e7c)
---
 apps/web/src/lib/workspaceFocus.browser.test.ts | 12 ++++++++++++
 apps/web/src/lib/workspaceFocus.ts              |  7 ++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/apps/web/src/lib/workspaceFocus.browser.test.ts b/apps/web/src/lib/workspaceFocus.browser.test.ts
index 719d237ef3..3fb29d3655 100644
--- a/apps/web/src/lib/workspaceFocus.browser.test.ts
+++ b/apps/web/src/lib/workspaceFocus.browser.test.ts
@@ -63,6 +63,18 @@ describe("workspace area focus", () => {
     expect(document.activeElement).toBe(panel.button);
   });
 
+  it("moves back out of a side chat whose areas reuse the main chat's names", () => {
+    using fixture = setup();
+    const composer = fixture.area("composer", 2);
+    const panel = fixture.area("panel", 4);
+    const sideComposer = fixture.area("composer", 2, panel.element);
+    composer.button.focus();
+    fixture.controller.move(1);
+    expect(document.activeElement).toBe(sideComposer.button);
+    fixture.controller.move(-1);
+    expect(document.activeElement).toBe(composer.button);
+  });
+
   it("skips hidden, inert, and maximized-away areas", () => {
     using fixture = setup();
     const sidebar = fixture.area("sidebar", 0);
diff --git a/apps/web/src/lib/workspaceFocus.ts b/apps/web/src/lib/workspaceFocus.ts
index 4a85774b99..a8ff2c45fc 100644
--- a/apps/web/src/lib/workspaceFocus.ts
+++ b/apps/web/src/lib/workspaceFocus.ts
@@ -271,7 +271,12 @@ export function createWorkspaceFocusController(doc: Document) {
     if (areas.length === 0) return false;
     const activeArea = doc.activeElement?.closest<HTMLElement>(AREA_SELECTOR);
     const currentId = fromArea ?? activeArea?.dataset.workspaceArea ?? lastArea;
-    const current = areas.findIndex((area) => area.dataset.workspaceArea === currentId);
+    // A side chat nests areas with the main chat's names, so prefer the focused element.
+    const activeIndex = fromArea || !activeArea ? -1 : areas.indexOf(activeArea);
+    const current =
+      activeIndex === -1
+        ? areas.findIndex((area) => area.dataset.workspaceArea === currentId)
+        : activeIndex;
     const index =
       current === -1
         ? direction === 1
